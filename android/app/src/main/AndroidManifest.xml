<?xml version="1.0" encoding="utf-8"?>
<!-- The package attribute is required by aapt2 link; it matches the namespace in
     app/build.gradle, which the Android Gradle Plugin takes as the authoritative value.
     uses-sdk pins the min/target API levels in the packaged manifest: without it aapt2
     links targetSdkVersion=0 and modern Android refuses the install outright. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.opurom.mobile"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- The socket capability: without this permission every TCP connect on the
         device fails with a SecurityException at the first socket call. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-permission capability: notifications (API 33+) and microphone
         are asked at runtime by PermissionBridge; both are declared here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Capability calls must install and degrade on devices without this hardware. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:debuggable="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dev hot reload: the CLI pushes a new IR into the app files dir and
             broadcasts RELOAD_ACTION; the live activity swaps the frame program
             over its retained state. Exported so `adb shell am broadcast` (uid
             2000) reaches it; this is a debug-only reload hook. -->
        <receiver
            android:name=".MainActivity$ReloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.opurom.mobile.RELOAD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
